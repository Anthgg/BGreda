# Normaliza finales de linea: el repositorio guarda siempre LF.
* text=auto eol=lf

# Archivos sensibles a CRLF que deben conservar LF incluso en Windows.
*.py     text eol=lf
*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.ini    text eol=lf
*.mako   text eol=lf
Dockerfile text eol=lf

# Binarios
*.png binary
*.jpg binary
*.pdf binary
