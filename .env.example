# =============================================================================
# BGreda - variables de entorno
# =============================================================================
# Copie este archivo a .env y complete los valores. .env NUNCA se commitea.
# Ningun valor real de este archivo debe contener secretos.
# =============================================================================

# ---- Aplicacion -------------------------------------------------------------
# local | development | staging | production
APP_ENV=local
APP_NAME=Cotizador Greda API
LOG_LEVEL=INFO

# ---- Supabase ---------------------------------------------------------------
# URL del proyecto Supabase (sin barra final).
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key entregada por el propietario del proyecto.
# Se usa SOLO desde el backend. Nunca se envia al frontend.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_TIMEOUT_SECONDS=10

# ---- Base de datos ----------------------------------------------------------
# Credencial PostgreSQL para SQLAlchemy y Alembic. Es DISTINTA de la
# publishable key: esta ultima no permite conectarse a PostgreSQL.
# Formato: postgresql://usuario:password@host:puerto/base
# Con el pooler de Supabase use el puerto 6543 (modo transaccion).
DATABASE_URL=

# ---- CORS -------------------------------------------------------------------
# Lista separada por comas. Nunca se admite "*": la API responde con cookies.
FRONTEND_ORIGINS=http://localhost:5173

# ---- Cookies ----------------------------------------------------------------
# Desarrollo local sobre http://localhost: COOKIE_SECURE=false y SameSite=lax.
# Produccion same-site (app.dominio / api.dominio): true + lax.
# Produccion cross-site (dominios *.run.app distintos): none + true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
REFRESH_COOKIE_MAX_AGE_SECONDS=2592000

# ---- CSRF -------------------------------------------------------------------
# Obligatorio en produccion, minimo 32 caracteres. Genere uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CSRF_SECRET=
CSRF_TOKEN_TTL_SECONDS=28800
