# =============================================================================
# BGreda - variables de entorno
# =============================================================================
# Copie este archivo a .env y complete los valores. .env NUNCA se commitea.
# Ningun valor real de este archivo debe contener secretos.
# =============================================================================

# ---- Aplicacion -------------------------------------------------------------
# local | development | staging | production
APP_ENV=local
APP_NAME=Cotizador Greda API
LOG_LEVEL=INFO

# ---- Supabase ---------------------------------------------------------------
# URL del proyecto Supabase (sin barra final).
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key entregada por el propietario del proyecto.
# Se usa SOLO desde el backend. Nunca se envia al frontend.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_TIMEOUT_SECONDS=10

# ---- Base de datos ----------------------------------------------------------
# Credencial PostgreSQL para SQLAlchemy y Alembic. Es DISTINTA de la
# publishable key: esta ultima no permite conectarse a PostgreSQL.
# Formato: postgresql://usuario:password@host:puerto/base
# Con el pooler de Supabase use el puerto 6543 (modo transaccion).
DATABASE_URL=

# ---- CORS -------------------------------------------------------------------
# Lista separada por comas. Nunca se admite "*": la API responde con cookies.
FRONTEND_ORIGINS=http://localhost:5173

# ---- Cookies ----------------------------------------------------------------
# Desarrollo local sobre http://localhost: COOKIE_SECURE=false y SameSite=lax.
# Produccion same-site (app.dominio / api.dominio): true + lax.
# Produccion cross-site (dominios *.run.app distintos): none + true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
REFRESH_COOKIE_MAX_AGE_SECONDS=2592000

# ---- CSRF -------------------------------------------------------------------
# Obligatorio en produccion, minimo 32 caracteres. Genere uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CSRF_SECRET=
CSRF_TOKEN_TTL_SECONDS=28800

# ---- Supabase Storage (logo de empresa, Fase 2) -----------------------------
# Clave con permiso de ESCRITURA en Storage. Es la "service_role" / "secret key"
# del proyecto, distinta de la publishable key.
#   Donde obtenerla: Supabase Dashboard -> Project Settings -> API Keys
#   Formato actual:  sb_secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#   Formato antiguo: un JWT largo que empieza por eyJhbGciOi...
#
# SOLO backend. Ignora RLS por completo: nunca debe llegar al frontend, ni a
# una variable VITE_*, ni a un log. En Cloud Run va en Secret Manager.
SUPABASE_SECRET_KEY=

# Bucket donde se guardan los archivos de la aplicacion. El backend lo crea si
# no existe. No se codifica en el fuente: se configura aqui.
SUPABASE_STORAGE_BUCKET=greda-assets

# Tamano maximo aceptado para el logo, en bytes (2 MiB por defecto).
LOGO_MAX_BYTES=2097152

# ---------------------------------------------------------------------------
# Consulta de identidad (DNI/RUC) — Fase 005.5
# ---------------------------------------------------------------------------
# Ambos tokens: solo backend. Nunca en una variable VITE_*, nunca en el
# frontend, nunca en Git. En Cloud Run van en Secret Manager (nombres
# sugeridos: peru-api-token, decolecta-api-token).
#
# Sin ninguno de los dos configurados, el servicio de identidad responde
# IDENTITY_LOOKUP_UNAVAILABLE en vez de impedir que la aplicacion arranque.
PERU_API_TOKEN=
PERU_API_BASE_URL=https://api.peruapi.com
DECOLECTA_API_TOKEN=
DECOLECTA_API_BASE_URL=https://api.decolecta.com

# Timeout por consulta a un proveedor, en segundos.
IDENTITY_PROVIDER_TIMEOUT_SECONDS=6.0

# TTL de la cache, en dias. El RUC cambia mas facilmente (estado, condicion,
# domicilio) que el DNI, de ahi la diferencia.
IDENTITY_DNI_CACHE_TTL_DAYS=30
IDENTITY_RUC_CACHE_TTL_DAYS=7

# Si un NOT_FOUND en el proveedor primario dispara el secundario. Por defecto
# no: un documento inexistente gastaria dos cuotas sin obtener informacion.
IDENTITY_FALLBACK_ON_NOT_FOUND=false

# Cuotas observadas de cada proveedor. Solo para avisos/observabilidad: la
# cuota real la impone el proveedor con su propio 429, esto no bloquea nada.
PERU_API_DAILY_LIMIT=50
PERU_API_MONTHLY_LIMIT=1000
DECOLECTA_MONTHLY_LIMIT=100

# Limite interno por documento y usuario, para que un bug o un doble clic no
# drene la cuota de un proveedor externo.
IDENTITY_RATE_LIMIT_MAX_REQUESTS=20
IDENTITY_RATE_LIMIT_WINDOW_SECONDS=300
